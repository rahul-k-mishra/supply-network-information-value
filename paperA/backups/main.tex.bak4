\centering
\includegraphics[width=0.49\textwidth]{fig1a_lam0_willems.png}
\hfill
\includegraphics[width=0.49\textwidth]{fig1b_lam0_syn.png}
\caption{Heuristic oracle advantage at $\lambda=0$: benchmark instances
(left) and synthetic networks (right).}
\label{fig:lam0}
\end{figure}

